{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "controllerManager": {
            "type": "object",
            "properties": {
                "manager": {
                    "type": "object",
                    "properties": {
                        "args": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "containerSecurityContext": {
                            "type": "object",
                            "properties": {
                                "allowPrivilegeEscalation": {
                                    "type": "boolean"
                                },
                                "capabilities": {
                                    "type": "object",
                                    "properties": {
                                        "drop": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                },
                                "readOnlyRootFilesystem": {
                                    "type": "boolean"
                                }
                            }
                        },
                        "env": {
                            "type": "object",
                            "properties": {
                                "bubuHubServiceName": {
                                    "type": "string"
                                },
                                "connectorImage": {
                                    "type": "string"
                                },
                                "connectorImagePullPolicy": {
                                    "type": "string"
                                }
                            }
                        },
                        "image": {
                            "type": "object",
                            "properties": {
                                "repository": {
                                    "type": "string"
                                },
                                "tag": {
                                    "type": "string"
                                }
                            }
                        },
                        "imagePullPolicy": {
                            "type": "string"
                        },
                        "resources": {
                            "type": "object",
                            "properties": {
                                "limits": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "requests": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "nodeSelector": {
                    "type": "object"
                },
                "podSecurityContext": {
                    "type": "object",
                    "properties": {
                        "runAsNonRoot": {
                            "type": "boolean"
                        },
                        "seccompProfile": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "replicas": {
                    "type": "integer"
                },
                "tolerations": {
                    "type": "array"
                },
                "topologySpreadConstraints": {
                    "type": "array"
                }
            }
        },
        "hub": {
            "type": "object",
            "properties": {
                "ports": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "port": {
                                "type": "integer"
                            },
                            "protocol": {
                                "type": "string"
                            },
                            "targetPort": {
                                "type": "integer"
                            }
                        }
                    }
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "kubernetesClusterDomain": {
            "type": "string"
        },
        "metricsService": {
            "type": "object",
            "properties": {
                "ports": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "port": {
                                "type": "integer"
                            },
                            "protocol": {
                                "type": "string"
                            },
                            "targetPort": {
                                "type": "integer"
                            }
                        }
                    }
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "operatorConfig": {
            "type": "object",
            "properties": {
                "connectorImage": {
                    "type": "string"
                },
                "connectorImagePullPolicy": {
                    "type": "string"
                },
                "hubBufferEvictionInterval": {
                    "type": "string"
                },
                "hubBufferEvictionTtl": {
                    "type": "string"
                },
                "hubBufferMaxBytes": {
                    "type": "string"
                },
                "hubBufferMaxMessages": {
                    "type": "string"
                },
                "hubChannelBufferSize": {
                    "type": "string"
                },
                "hubMaxActiveStreams": {
                    "type": "string"
                },
                "hubMaxBuffers": {
                    "type": "string"
                },
                "hubMaxDownstreamsHardCap": {
                    "type": "string"
                },
                "hubPerMessageTimeout": {
                    "type": "string"
                },
                "hubTransportSecurityMode": {
                    "type": "string"
                },
                "telemetryTracePropagation": {
                    "type": "string"
                },
                "templatingDeterministic": {
                    "type": "string"
                },
                "templatingEvaluationTimeout": {
                    "type": "string"
                },
                "templatingMaterializeEngram": {
                    "type": "string"
                },
                "templatingMaxOutputBytes": {
                    "type": "string"
                },
                "templatingOffloadedDataPolicy": {
                    "type": "string"
                }
            }
        },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "annotations": {
                    "type": "object"
                },
                "automount": {
                    "type": "boolean"
                },
                "create": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "webhookService": {
            "type": "object",
            "properties": {
                "ports": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "port": {
                                "type": "integer"
                            },
                            "protocol": {
                                "type": "string"
                            },
                            "targetPort": {
                                "type": "integer"
                            }
                        }
                    }
                },
                "type": {
                    "type": "string"
                }
            }
        }
    }
}
